# PostgreSQL
POSTGRES_DB=coachme
POSTGRES_USER=coachme
POSTGRES_PASSWORD=changeme

# Spring Boot datasource
POSTGRES_URL=jdbc:postgresql://postgres:5432/coachme

# JWT
JWT_SECRET=change-this-to-a-256-bit-secret-in-production
JWT_EXPIRY_MS=900000

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASS=changeme

# App
APP_DOMAIN=app.com
