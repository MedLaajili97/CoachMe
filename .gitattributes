# Default: normalize line endings to LF in repo, checkout as-is on Windows
* text=auto

# Force LF for files that run inside Linux containers
Dockerfile*       text eol=lf
*.sh              text eol=lf
*.conf            text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.sql             text eol=lf
*.env*            text eol=lf
